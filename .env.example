# ============================================================
# 智能客服统一配置模板
# 复制为 .env 后填写；不要直接改本文件。
# Docker Compose 启动时也会读取根目录 .env。
# 下面默认值与本项目 docker-compose.yml 的本地演示环境一致。
# 同一份 .env 同时给客服层、retrieve_skill、nl2sql_skill 使用。
# ============================================================

# --- 客服层 ---
TENANT_ID=merchant
KB_ID=merchant_kb
DB_ID=erp
RESPONSE_CACHE_PREFIX=customer_service
RESPONSE_CACHE_TTL=1800
RESPONSE_CACHE_SHORT_TTL=300
HISTORY_MAX_MESSAGES=20
MAX_CLARIFICATION_ROUNDS=2

# --- LLM（意图识别 / 回答生成 / 闲聊，retrieve 查询改写共用）---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# --- Embedding（retrieve_skill）---
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内网络可改为 https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# --- Milvus（retrieve_skill）---
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_SECURE=false
MILVUS_DB=
MILVUS_TEXT_COLLECTION=mushroom_knowledge
MILVUS_DIM=512
MILVUS_OUTPUT_FIELDS=id,content,source,category,parent_id,chunk_index,tenant_id,kb_id,doc_version

# --- MySQL 父块权威存储（retrieve_skill）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=rag_test
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=3
MYSQL_READ_TIMEOUT=5
MYSQL_POOL_MAX_CONNECTIONS=10
RAG_PARENT_TABLE=rag_parent_block
RAG_PARENT_STATUS=active

# --- Redis（回答缓存 + 两个 pipeline 的检索/SQL 缓存）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL=1800
REDIS_KEY_PREFIX=rag
REDIS_SOCKET_TIMEOUT=3

# --- 检索与精排（retrieve_skill）---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_RELEVANCE=0.0
RETRIEVAL_HYBRID_WORKERS=16
RRF_TOP_K=20
RRF_K=60
RERANK_TOP_K=3
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CE_WEIGHT=0.6
RERANKER_RETRIEVAL_WEIGHT=0.4
RERANKER_DEVICE=
CONTEXT_MAX_TOKENS=6000
MAX_DOC_TOKENS=3000
RETRIEVAL_QUERY_REWRITE_MODE=off

# --- NL2SQL（nl2sql_skill，SQL 生成必填）---
NL2SQL_LLM_BASE_URL=
NL2SQL_LLM_API_KEY=
NL2SQL_LLM_MODEL=
NL2SQL_LLM_TEMPERATURE=0
NL2SQL_LLM_MAX_TOKENS=2048
NL2SQL_LLM_TIMEOUT_SECONDS=30

# 数据源：NL2SQL_DB_<ID>_DSN，<ID> 只允许大写字母/数字/下划线，调用传小写 db_id。
NL2SQL_DB_ERP_DSN=mysql://root:change-me@127.0.0.1:3307/commerce
NL2SQL_DB_ERP_SERVER_VERSION=8.0
NL2SQL_DB_ERP_VISIBLE_TABLES=

NL2SQL_SEMANTIC_DIR=
NL2SQL_CLARIFY_THRESHOLD=0.75
NL2SQL_MAX_ROWS=200
NL2SQL_HISTORY_MAX_TOKENS=2000
NL2SQL_SCHEMA_CONTEXT_MAX_TOKENS=4000
NL2SQL_TOP_K_TABLES=8
NL2SQL_EXAMPLE_MIN_SIMILARITY=0.75
NL2SQL_EXAMPLE_STORE_PATH=
NL2SQL_EXECUTOR_ENABLED=true
NL2SQL_COST_GUARD_ENABLED=false
NL2SQL_COST_THRESHOLD_ROWS=5000000
NL2SQL_EXPLAIN_FAIL_POLICY=deny
NL2SQL_SQL_CACHE_ENABLED=true
NL2SQL_SQL_CACHE_TTL_SECONDS=86400
NL2SQL_CACHE_KEY_INCLUDE_HISTORY=false

# --- 鉴权（本地开发用 disabled；公网部署必须 jwt）---
AUTH_MODE=disabled
# AUTH_JWT_SECRET=

# --- 指标（可选）---
METRICS_ENABLED=false
METRICS_PREFIX=customer_service
METRICS_PORT=9090
METRICS_BIND=127.0.0.1
